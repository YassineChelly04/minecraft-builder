# Required
GROQ_API_KEY=your_groq_api_key_here

# Default model for every agent role. A small, fast, NON-reasoning model is recommended:
# the deterministic shell + repair layer handle structure and block validity, so the model
# only emits detail/furniture. Avoid reasoning models (gpt-oss) — they burn the token budget.
LLM_MODEL=llama-3.1-8b-instant

# Per-role overrides — tune cost vs. quality. For nicer detail/furniture on a paid tier,
# bump the two build roles to a larger model; keep the cheap roles small.
# LLM_MODEL_INTENT=llama-3.1-8b-instant
# LLM_MODEL_CLARIFY=llama-3.1-8b-instant
# LLM_MODEL_EXTERIOR=llama-3.3-70b-versatile
# LLM_MODEL_INTERIOR=llama-3.3-70b-versatile
# LLM_MODEL_CRITIC=llama-3.1-8b-instant

# Network resilience for free-tier rate limits (reset per minute).
# LLM_MAX_RETRIES=4
# LLM_RETRY_DELAY=2.0
